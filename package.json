{
  "name": "@drml/cli",
  "version": "0.1.0-beta",
  "description": "An explicit package manager for JavaScript and TypeScript projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drmlStudio/drml.git"
  },
  "homepage": "https://github.com/drmlStudio/drml",
  "bugs": {
    "url": "https://github.com/drmlStudio/drml/issues"
  },
  "keywords": [
    "package-manager",
    "javascript",
    "typescript",
    "zig"
  ],
  "bin": {
    "drml": "bin/drml.wasm"
  },
  "scripts": {
    "build": "zig build -Dtarget=wasm32-wasi -Doptimize=ReleaseSafe",
    "fmt": "zig fmt drml/src"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
