{
  "name": "@drml/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An explicit package manager for JavaScript and TypeScript projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drmlStudio/drml.git"
  },
  "homepage": "https://github.com/drmlStudio/drml",
  "bugs": {
    "url": "https://github.com/drmlStudio/drml/issues"
  },
  "keywords": [
    "package-manager",
    "javascript",
    "typescript",
    "zig"
  ],
  "workspaces": [
    "drml",
    "website"
  ],
  "bin": {
    "drml": "index.js"
  },
  "scripts": {
    "build": "zig build -Doptimize=ReleaseSafe",
    "fmt": "zig fmt .",
    "build:test": "zig build test",
    "test:zig": "zig build test",
    "test:unit": "vitest run --config vitest.test.ts",
    "test": "npm run test:unit",
    "test:integration": "vitest run --config vitest.integration.test.ts"
  },
  "files": [
    "index.js",
    "install.js",
    "native.js",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}