    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@drml/x86_64-windows": "0.1.1",
    "@drml/aarch64-windows": "0.1.1",
    "@drml/aarch64-macos": "0.1.1",
    "@drml/x86_64-macos": "0.1.1",
    "@drml/x86_64-linux-gnu": "0.1.1",
    "@drml/aarch64-linux-gnu": "0.1.1",
    "@drml/x86_64-linux-musl": "0.1.1",
    "@drml/aarch64-linux-musl": "0.1.1"
  },
  "engines": {
    "node": ">=20"
  }
