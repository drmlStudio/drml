{
  "name": "@drml/cli",
  "version": "0.1.2",
  "type": "module",
  "description": "An explicit package manager for JavaScript and TypeScript projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drmlStudio/drml.git"
  },
  "homepage": "https://github.com/drmlStudio/drml",
  "bugs": {
    "url": "https://github.com/drmlStudio/drml/issues"
  },
  "keywords": [
    "package-manager",
    "javascript",
    "typescript",
    "zig"
  ],
  "bin": {
